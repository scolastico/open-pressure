<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="main_sync_clock">시계 동기화</string>
    <string name="main_sync_clock_explanation">혈압계 시계를 이 휴대전화의 시간으로 맞춥니다. 변경되기 전에 두 시간을 모두 보고 확인합니다. 그런 다음 연결이 종료되므로 측정값을 가져오려면 다시 연결하세요.</string>
    <string name="main_sync_clock_running">시계 동기화 중…</string>
    <string name="clock_sync_title">시계 동기화 확인</string>
    <string name="clock_sync_monitor_time">혈압계 시계: %1$s</string>
    <string name="clock_sync_monitor_time_unset">혈압계 시계: 설정되지 않음</string>
    <string name="clock_sync_phone_time">휴대전화 시간: %1$s</string>
    <plurals name="clock_sync_drift">
        <item quantity="other">차이: %1$d초</item>
    </plurals>
    <string name="clock_sync_within_threshold">혈압계 시계가 휴대전화 시간과 1분 이내로 차이 나므로 변경하지 않습니다.</string>
    <string name="clock_sync_untested_warning">이 혈압계에서는 시계 동기화가 아직 테스트되지 않았습니다. 개발자 옵션을 켰기 때문에만 사용할 수 있습니다. 이 위험을 감수할 경우에만 계속하세요.</string>
    <string name="clock_sync_choose_time">설정할 시간(개발자 옵션)</string>
    <string name="clock_sync_confirm">지금 동기화</string>
    <string name="monitor_clock_sync_complete">시계가 동기화됨</string>
    <string name="monitor_clock_sync_skipped">시계가 이미 정확함</string>
    <string name="monitor_clock_sync_rejected">시계 동기화 실패</string>
    <string name="monitor_clock_sync_cancelled">시계 동기화 취소됨</string>
    <string name="monitor_clock_sync_unreadable">시계를 동기화할 수 없음</string>
    <string name="monitor_clock_sync_reconnect">측정값을 가져오려면 다시 연결하세요.</string>
    <string name="clock_sync_report_prompt">아직 이 기능이 테스트되지 않은 혈압계의 시계를 동기화했습니다. GitHub issue에 기기 보고서를 공유하면 성공 여부를 알 수 있고 다른 사람도 시계 동기화를 사용할 수 있도록 도울 수 있습니다.\n\n보고서에는 기술 정보만 포함됩니다. 측정값, 측정 시간, 이름, 블루투스 주소, 일련번호는 절대 포함되지 않습니다. 공유하기 전에 내용을 검토할 수 있습니다.</string>
</resources>
