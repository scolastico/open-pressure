<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="reminder_title">የመለኪያ ማስታወሻዎች</string>
    <string name="reminder_intro">ስልክዎ እንዲለኩ መቼ እንደሚያስታውስዎ ይምረጡ። እነዚህ ማስታወሻዎች በደም ግፊት መለኪያዎ ላይ ያሉ ማንቂያዎችን አይቀይሩም።</string>
    <string name="reminder_add">ማስታወሻ ጨምር</string>
