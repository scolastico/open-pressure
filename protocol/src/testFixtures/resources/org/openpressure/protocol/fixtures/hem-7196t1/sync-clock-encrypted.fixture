# HEM-7196T1-FLE (M4 Connect AFib): OpenPressure's explicit Sync clock over the encrypted X7 session with a saved
# application key. Experimental and hardware-untested twice over: the encrypted clock write needs the developer switch
# CLOCK_SYNC_ENCRYPTED_X7, and this identity's clock block is untested (developer override). Omron Connect has no
# standalone clock sync (it writes the clock after every transfer, see hem-7196t1/connect-encrypted), so its runner
# reports `unsupported` and every step after the authorization poll is OpenPressure-only. Steps after `secure` are
# plaintext; the cuff-side test peer decrypts and encrypts them (docs/omron-sandbox.md).
name hem-7196t1/sync-clock-encrypted
flow sync-clock
advertise name=BLEsmart_000000EB0011223344 services=0000fe4a-0000-1000-8000-00805f9b34fb msd=0e020901000000eb0001000100
# Synthetic Device Information. The model string a physical HEM-7196T1-FLE reports is unknown; OpenPressure accepts only
# the exact model number. Omron reads the serial number on this model, OpenPressure only the model.
dis model=HEM-7196T1-FLE serial=0000000001 firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
# The application key (LTK) both clients saved from an earlier pairing; the cuff peer holds the same key. It never
# appears on the link.
key 5a17c0ffee5a17c0ffee5a17c0ffee5a
mtu 247

alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b
alias sys b305b680-aee7-11e1-a730-0002a5d5c51b

# Only the settings/index image is read. Index: per user next write position 1, one unsent record and sequence number 1.
memory fill=ff
memory 0x10 0100 0100 0100 0100 01000000 01000000 000000000000 0000
# Setting-information block 3 at 0x3c: both users registered (byte 48), monitor clock 2025-12-31 23:00:00 (more than 60 s
# from the fixture time), additive checksum of bytes 44-57 at byte 58. Block 4 at 0x4c is zero.
memory 0x3c 00000000 03000000 190c1f170000 5e00
memory 0x4c 0000000000000000

nonce sys
# Saved-key authentication: 70 05 / F0 85, 70 06 / F0 86 (docs/protocol.md). The reserved bytes of the cuff's F0 85
# carry a synthetic stand-in for its Bluetooth address, as in the capture; their exact layout is not pinned.
secure sys saved reserved=aabbccddeeff00000000000000000000
# Encrypted authorization poll on SYS; the cuff reports COMPLETE (01) at once.
write sys 20 01 00 00000000000000000000000000000000 00
notify sys a0 01 00 01 00000000000000000000000000000000

write tx 08 00 00 00 00 10 00 18
notify rx 08 80 00 00 00 10 00 98
[ours-only: Sync clock reads the 68-byte settings image at 0x10 in 16-byte blocks before the write; Omron has no standalone clock sync] reads 0x10 68 chunk=16
# Block 3 at its staging address 0x80 with the clock set to fixture time + 1 s and the checksum recomputed (2d), in one
# 24-byte frame validated in plaintext and sent encrypted. The acknowledgment is a synthetic full echo.
[ours-only: OpenPressure-only clock-block write (explicit Sync clock) over the encrypted session (developer switches CLOCK_SYNC_ENCRYPTED_X7 and the untested clock-block override; docs/safety.md)] write tx 1801c0008010 00000000030000001a01020304062d00 007f
[ours-only: synthetic full echo acknowledgment; the physical monitor reply is unconfirmed] notify rx 1881c0008010 00000000030000001a01020304062d00 00ff
write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect clock acknowledged
