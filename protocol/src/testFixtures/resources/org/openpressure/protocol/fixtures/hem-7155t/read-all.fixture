# HEM-7155T (EBK identity): Read all for user 2 only. OpenPressure reconnects with the saved key and reads every
# slot of the selected user's bank without consulting the index; user 1's bank is not read.
# Omron Connect has no read-all operation, so the Omron sandbox reports this fixture as unsupported.
name hem-7155t/read-all
flow read-all
import users=2
advertise name=BLEsmart_000002640011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
dis model=HEM-7155T-EBK firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b
alias clock 00002a2b-0000-1000-8000-00805f9b34fb

# Same synthetic records as hem-7155t/connect-read-history (record checksum at offset 14 checked by OpenPressure):
# user 1: 130/78 mmHg, pulse 67, 2025-07-09 06:14:38; user 2: 120/80 mmHg, pulse 70, 2025-08-01 07:30:00.
memory fill=ff
memory 0x98 694e4319261da603 0000 0100 00000000
memory 0x458 5f504619 27208007 0000 0100 0000 dd00
memory 0x10 0100 0100 0100 0100 01000000 01000000

write unlock 01 05050505050505050505050505050505
notify unlock 8100

write tx 08 00 00 00 00 10 00 18
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 00 88

[ours-only: Read all sweeps every slot of the selected user's bank (user 2) in 48-byte blocks without the index; Omron has no read-all operation] reads 0x458 960 chunk=48

[ours-only: OpenPressure clock sync via Current Time; Omron writes setting block 3 instead (docs/omron-sandbox.md)] write clock ea 07 01 02 03 04 05 05 00 01

write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

[ours-only: Read all of user 2 only; Omron has no read-all operation] expect reading user=2 sys=120 dia=80 pulse=70 time=2025-08-01T07:30:00
