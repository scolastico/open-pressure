# HEM-7196T1-FLEO (X4 Connect AFib): plain single-channel WLP, read both users' history, end the session. Experimental and
# hardware-untested in OpenPressure; whether a physical cuff advertises a plain type at all is unknown.
# Omron selects HEM-7196T1-FLEO from the advertised IDs (category 0x0000, model 0x00E1) and, with ohqMtuSize=244,
# its single-channel WLP graph; the plain manufacturer type 1 (no saved key) selects plain WLP1COM in both clients.
# Omron's configuration equals the HEM-7380T1-EOSL apart from 60 records per user, so user 2's bank starts at 0x584.
name hem-7196t1-fleo/connect-read-history
flow connect
advertise name=BLEsmart_000000E10011223344 services=0000fe4a-0000-1000-8000-00805f9b34fb msd=0e020101010001010001
# Synthetic Device Information. The model string a physical HEM-7196T1-FLEO reports is unknown; OpenPressure accepts only
# the exact model number. Omron reads the serial number on this model, OpenPressure only the model.
dis model=HEM-7196T1-FLEO serial=0000000001 firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
# Plain WLP uses no application key; the format requires one, and no client sends it.
key 05050505050505050505050505050505
mtu 247

alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b
alias sys b305b680-aee7-11e1-a730-0002a5d5c51b

# One synthetic record per user, each with sequence number 1 at offset 10 and the 8-bit sum of bytes 0-13 at
# offset 14 (Omron rejects a record whose sum differs):
# user 1: 130/78 mmHg, pulse 67, 2025-07-09 06:14:38, no flags;
# user 2: 120/80 mmHg, pulse 70, 2025-08-01 07:30:00 with the AFib bit (word 6 bit 13) and the irregular-pulse and
# movement bits (word 4 bits 14 and 15) all set. This model's VitalDataIndexes report irregular pulse and movement
# as 0 whenever AFib is set; OpenPressure applies the same masking for this identity.
memory fill=ff
memory 0x1c4 694e4319 261d a603 0000 0100 00000000
memory 0x584 5f504619 27e0 8027 0000 0100 0000 bd00
# Index (index_setting_read_address=10): per user next write position 1, one unsent record and sequence number 1;
# empty error-log and pulse-wave pointers.
memory 0x10 0100 0100 0100 0100 01000000 01000000 000000000000 0000
# Setting-information block 3 at 0x3c: both users registered (byte 48), clock 2026-01-02 03:04:05, additive
# checksum of bytes 44-57 at byte 58. Block 4 at 0x4c is zero.
memory 0x3c 00000000 03000000 1a0102030405 2c00
memory 0x4c 0000000000000000

nonce sys

write tx 08 00 00 00 00 10 00 18
notify rx 08 80 00 00 00 10 00 98

[omron-only: Omron reads the index (index_setting_pointer_unsend_size 24 plus setting-information blocks 1 and 2) in one frame] reads 0x10 44 chunk=44
[omron-only: Omron reads setting-information blocks 3 and 4 at 0x3c in one frame] reads 0x3c 24 chunk=24
[ours-only: OpenPressure reads the 68-byte settings/index image at 0x10 in 16-byte blocks, then the slots it lists as populated; Omron reads 44 bytes plus blocks 3 and 4, then the unsent records] reads 0x10 68 chunk=16

# Both clients read the one record per user with the identical frame: OpenPressure because the index lists one
# populated slot, Omron because it lists one unsent record. User 2's slot 0 is at 0x584 on this 60-slot map.
reads 0x1c4 16 chunk=16
reads 0x584 16 chunk=16

# Omron Connect 2026.09.03 post-transfer settings frames, recorded against this synthetic fixture; each is one
# single-channel write. Replies are synthetic full echoes; no physical monitor's acknowledgment is established.
[omron-only: Omron 2026.09.03 post-transfer index prefix at 0x54 (24 bytes), with the last-read user's (user 2) unsent counter cleared to 0x8000 and its error-log unsent count (offset 19) to 0x80; docs/omron-sandbox.md] write tx 2001c0005418 010001000100008001000000010000000000008000000000 00ac
[omron-only: synthetic full echo acknowledgment; the physical monitor reply is unconfirmed] notify rx 2081c0005418 010001000100008001000000010000000000008000000000 002c
[omron-only: Omron 2026.09.03 settings at 0x76, birthday block 2 (default 1900-01-01) merged with block 3 (clock = fixture time + 1 s, checksum 2d); docs/omron-sandbox.md] write tx 2201c000761a 000101fffffffffffdff 00000000030000001a01020304062d00 0044
[omron-only: synthetic full echo acknowledgment; the physical monitor reply is unconfirmed] notify rx 2281c000761a 000101fffffffffffdff 00000000030000001a01020304062d00 00c4

# Both clients use the normal END after completing their respective steps.
write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect reading user=1 sys=130 dia=78 pulse=67 time=2025-07-09T06:14:38 irregular=0 movement=0 afib=0
expect reading user=2 sys=120 dia=80 pulse=70 time=2025-08-01T07:30:00 irregular=0 movement=0 afib=1
