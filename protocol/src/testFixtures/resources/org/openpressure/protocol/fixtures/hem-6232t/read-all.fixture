# HEM-6232T (Z identity): Read all for both users. OpenPressure reconnects with the saved key and reads every
# slot of both banks without consulting the index. Omron Connect has no read-all operation, so the Omron
# sandbox reports this fixture as unsupported.
name hem-6232t/read-all
flow read-all
import users=both
advertise name=BLEsmart_000001440011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
dis model=HEM-6232T firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b
alias clock 00002a2b-0000-1000-8000-00805f9b34fb

# Same synthetic 14-byte records (byte pairs swapped) as hem-6232t/connect-read-history:
# user 1 130/78 mmHg, pulse 67, 2025-07-09 06:14:38; user 2 120/80, pulse 70, 2025-08-01 07:30:00.
memory fill=ff
memory 0x2e8 4e691943 1d2603a6 0000 0001 0000
memory 0x860 505f1946 20270780 0000 0001 dddd
memory 0x260 0001 0001 0001 0001 00010000 00010000

write unlock 01 05050505050505050505050505050505
notify unlock 8100

write tx 08 00 00 00 00 10 00 18
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 00 88

[ours-only: Read all sweeps every slot of bank 1 in 56-byte blocks without the index; Omron has no read-all operation] reads 0x2e8 1400 chunk=56
[ours-only: Read all sweeps every slot of bank 2 in 56-byte blocks without the index; Omron has no read-all operation] reads 0x860 1400 chunk=56

[ours-only: OpenPressure clock sync via Current Time; Omron writes setting block 3 instead (docs/omron-sandbox.md)] write clock ea 07 01 02 03 04 05 05 00 01

write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

[ours-only: Read all of both users; Omron has no read-all operation] expect reading user=1 sys=130 dia=78 pulse=67 time=2025-07-09T06:14:38
[ours-only: Read all of both users; Omron has no read-all operation] expect reading user=2 sys=120 dia=80 pulse=70 time=2025-08-01T07:30:00
