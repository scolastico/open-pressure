# HEM-7155T (EBK identity): explicit Sync clock whose acknowledgment carries a non-zero status. OpenPressure
# treats it as rejected, does not retry and still ends the session. Omron has no standalone clock sync (unsupported).
name hem-7155t/sync-clock-rejected
flow sync-clock
advertise name=BLEsmart_000002640011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
dis model=HEM-7155T-EBK firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b

# Block 3 (0x3c..0x4b) stays erased through the fill byte.
memory fill=ff

write unlock 01 05050505050505050505050505050505
notify unlock 8100

write tx 08 00 00 00 00 10 00 18
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 00 88

[ours-only: Sync clock reads the 68-byte settings image at 0x10 in 56-byte blocks before the write; Omron has no standalone clock sync] reads 0x10 68 chunk=56

[ours-only: OpenPressure-only clock-block write (explicit Sync clock); Omron has no standalone clock sync and writes the clock only after a transfer] write tx 1801c0008010 ffffffffffffffff1a010203040622ff 008c
[ours-only: synthetic full echo with status 01 instead of 00 to exercise rejection; no physical monitor reply is established] notify rx 1881c0008010 ffffffffffffffff1a010203040622ff 010d

# The session always ends with the normal END, whatever the clock outcome.
write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect clock rejected
