# HEM-7143T1-D: synthetic single-channel WLD1 pair probe; one user, 30 records.
# REA OHQBleDevice.m selects WLP1COM for this non-default ohqMtuSize and plain manufacturer type.
# Memory facts come from this exact catalog entry. No physical Device Information string is known.
# OpenPressure uses the exact read map; these scripts establish only synthetic interoperability.
name hem-7143t1-d/pair
flow pair
advertise name=BLEsmart_000002890011223344 services=0000fe4a-0000-1000-8000-00805f9b34fb msd=0e020108010001
dis model=HEM-7143T1-D serial=0000000001 firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505
mtu 67
expect omron matches

alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b
alias sys b305b680-aee7-11e1-a730-0002a5d5c51b

memory fill=ff
memory 0x260 01000000010000000100000000000000
memory 0x28c 00000000010000001a01020304052a00
memory 0x29c 0000000000000000
memory 0x2e8 694e4319261da603000001000000

nonce sys

[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] write tx 08 00 00 00 00 10 00 18
[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] notify rx 08 80 00 00 00 10 00 98
[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] reads 0x260 44 chunk=44
[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] reads 0x28c 24 chunk=24

# Official post-transfer memory writes observed with this synthetic peer only.
# These writes are Omron-only; OpenPressure does not change device memory during imports.
# Echo acknowledgments are invented and establish no physical device behavior.
[omron-only: official 2026.09.03 settings write at 0x2a4; docs/bluetooth-coverage.md] write tx 2601c002a41e01000000008000000100000000000000000101fffffffffffffffffff9ff0026
[omron-only: synthetic full-echo acknowledgment, unconfirmed on hardware] notify rx 2681c002a41e01000000008000000100000000000000000101fffffffffffffffffff9ff00a6
[omron-only: official 2026.09.03 settings write at 0x2d0; docs/bluetooth-coverage.md] write tx 1801c002d01000000000010000001a01020304062b000029
[omron-only: synthetic full-echo acknowledgment, unconfirmed on hardware] notify rx 1881c002d01000000000010000001a01020304062b0000a9

[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] write tx 08 0f 00 00 00 00 00 07
[omron-only: official plain Pair registers a profile; OpenPressure ends Pair in the read-only ready state] notify rx 08 8f 00 00 00 00 00 87
