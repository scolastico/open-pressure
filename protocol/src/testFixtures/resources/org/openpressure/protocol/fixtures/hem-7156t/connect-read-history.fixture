# HEM-7156T: reconnect with a saved key, read history, end the session.
# Omron selects HEM-7156T_AP from the advertised IDs (category 0x0000, model 0x057A);
# OpenPressure selects its base HEM-7156T map from the Device Information model.
name hem-7156t/connect-read-history
flow connect
advertise name=BLEsmart_0000057A0011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
# Synthetic Device Information; Omron reads the revisions and the System ID during connection setup.
dis model=HEM-7156T firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b
alias clock 00002a2b-0000-1000-8000-00805f9b34fb

# One synthetic 130/78 mmHg, pulse 67, 2025-07-09 06:14:38 record in the first slot of bank 1, sequence
# number 1 at offset 10 (Omron rejects a record whose sequence number does not match its index). Byte 14 is
# Omron's record checksum, the 8-bit sum of bytes 0-13, which is 00 for this record.
# Every other slot is erased (ff), so both clients must decode exactly one reading.
memory fill=ff
memory 0x98 694e4319261da603 0000 0100 00000000
# Index block (Omron DeviceConfig index_setting_read_address=10): next write position 1, one unsent record,
# sequence number 1, little-endian words. Accepted by Omron Connect 2026.09.03.
memory 0x10 0100 0000 0100 0000 01000000

# Unlock with the saved key. Omron confirms encryption first on every connection (docs/protocol.md).
[omron-only: Omron 2026.09.03 sends 02 (confirm encryption) before authenticating, observed in the sandbox] write unlock 02 00000000000000000000000000000000
[omron-only: acknowledgment for the confirm-encryption frame above] notify unlock 8200
write unlock 01 05050505050505050505050505050505
notify unlock 8100

# Start frame and synthetic identity block (identical in both clients).
write tx 08 00 00 00 00 10 00 18
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 00 88

[omron-only: Omron reads the HEM-7156T_AP index block (index_setting_read_address) before records] reads 0x10 44 chunk=44
[omron-only: Omron reads setting-info block 3 (index_setting_info_read_address 0x20 + 28)] reads 0x3c 16 chunk=16

[ours-only: index-driven populated-slot read: OpenPressure reads the 68-byte settings/index image at 0x10 in 56-byte blocks, then only the slots it lists as populated; Omron reads 44 bytes plus block 3 and then only unsent records] reads 0x10 68 chunk=56

# Both clients read the one record per user with the identical frame: OpenPressure because the index lists one
# populated slot, Omron because it lists one unsent record. The mechanisms differ (open finding on the index read above).
reads 0x98 16 chunk=16

# Omron writes the monitor's memory after every transfer (OGSCWlpDevice setDeviceSettings): the index prefix
# with the unsent counter cleared (bytes 4-5 0100 -> 0080), setting block 1 with the profile's birthday when it differs (the sandbox uses the
# app's default 1900-01-01) and block 3 with the clock (fixture time + 1 s) and its additive checksum.
# OpenPressure writes nothing after its reads; it sets the clock only in an explicit Sync clock session
# (hem-7155t/sync-clock).
[omron-only: Omron's post-transfer settings write: prefix at index_setting_write_address 0x54 with the cleared unsent counter, merged with block 1 (birthday 1900-01-01, checksum f9)] write tx 26 01 c0 00 54 1e 01000000 0080 0000 01000000 ffffffff 000101 ffffffffffffffffff f9 ff 00 d4
[omron-only: synthetic full echo acknowledgment; a real HEM-7156T reply is unconfirmed] notify rx 26 81 c0 00 54 1e 01000000 0080 0000 01000000 ffffffff 000101 ffffffffffffffffff f9 ff 00 54
[omron-only: block 3 at 0x80 with the clock (field 100e, bytes 52-57 = fixture time + 1 s) and its additive checksum] write tx 18 01 c0 00 80 10 ffffffffffffffff 1a0102030406 22 ff 00 8c
[omron-only: synthetic full echo acknowledgment; a real HEM-7156T reply is unconfirmed] notify rx 18 81 c0 00 80 10 ffffffffffffffff 1a0102030406 22 ff 00 0c

# END is identical in both clients once Omron's session completes normally.
write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect reading user=1 sys=130 dia=78 pulse=67 time=2025-07-09T06:14:38
