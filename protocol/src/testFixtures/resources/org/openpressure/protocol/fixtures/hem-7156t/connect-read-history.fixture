# HEM-7156T: reconnect with a saved key, read history, end the session.
# Omron selects HEM-7156T_AP from the advertised IDs (category 0x0000, model 0x057A);
# OpenPressure selects its base HEM-7156T map from the Device Information model.
name hem-7156t/connect-read-history
flow connect
advertise name=BLEsmart_0000057A0011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
dis model=HEM-7156T
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b
alias clock 00002a2b-0000-1000-8000-00805f9b34fb

# One synthetic 130/78 mmHg, pulse 67, 2025-07-09 06:14:38 record in the first slot of bank 1.
# Every other slot is erased (ff), so both clients must decode exactly one reading.
memory fill=ff
memory 0x98 694e4319261da6030000000000000000

# Unlock with the saved key.
[omron-only: docs/protocol.md - Omron's WLP4COM graph confirms encryption with 02 on every connection] write unlock 02 00000000000000000000000000000000
[omron-only: acknowledgment for the confirm-encryption frame above] notify unlock 8200
write unlock 01 05050505050505050505050505050505
notify unlock 8100

# Start frame and synthetic identity block.
write tx 08 00 00 00 00 10 00 18
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 00 88

# Bank 1: 60 records of 16 bytes.
reads 0x98 960 chunk=16
# Bank 2 exists only in the pinned omblepy map.
[ours-only: omblepy two-bank map; Omron HEM-7156T_AP declares one 60-record area, unconfirmed] reads 0x458 960 chunk=16

# OpenPressure updates the clock through Current Time before END.
[ours-only: OpenPressure clock sync via Current Time; Omron behavior not yet observed] write clock ea 07 01 02 03 04 05 05 00 01

write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect reading user=1 sys=130 dia=78 pulse=67 time=2025-07-09T06:14:38
