# HEM-7188T1-LE: synthetic single-channel WLD4 connect probe; one user, 30 records.
# REA OHQBleDevice.m selects WLP1COM for this non-default ohqMtuSize and plain manufacturer type.
# Memory facts come from this exact catalog entry. No physical Device Information string is known.
# OpenPressure uses the exact read map; these scripts establish only synthetic interoperability.
name hem-7188t1-le/connect-read-history
flow connect
advertise name=BLEsmart_000000DE0011223344 services=0000fe4a-0000-1000-8000-00805f9b34fb msd=0e020100010001
dis model=HEM-7188T1-LE serial=0000000001 firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505
mtu 247
expect omron matches

alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b
alias sys b305b680-aee7-11e1-a730-0002a5d5c51b

# User 1 also exercises date flag bits, reserved year bits where applicable, and the model-specific movement/IHB rule.
memory fill=ff
memory 0x10 010000000100000001000000000000000000000000000000
memory 0x3c 00000000010000001a01020304052a00
memory 0x4c 0000000000000000
memory 0x1c4 694e431926dda623000001000000e000

nonce sys

write tx 08 00 00 00 00 10 00 18
notify rx 08 80 00 00 00 10 00 98
[omron-only: official index and setting-block reads; OpenPressure reads its complete bounded settings image] reads 0x10 44 chunk=44
[omron-only: official index and setting-block reads; OpenPressure reads its complete bounded settings image] reads 0x3c 24 chunk=24
[ours-only: read the complete model-bound 68-byte settings/index image before populated slots] reads 0x10 68 chunk=16
reads 0x1c4 16 chunk=16

# Official post-transfer memory writes observed with this synthetic peer only.
# These writes are Omron-only; OpenPressure does not change device memory during imports.
# Echo acknowledgments are invented and establish no physical device behavior.
[omron-only: official 2026.09.03 settings write at 0x54; docs/bluetooth-coverage.md] write tx 2a01c0005422010000000080000001000000000000000080000000000000000101fffffffffffdff0060
[omron-only: synthetic full-echo acknowledgment, unconfirmed on hardware] notify rx 2a81c0005422010000000080000001000000000000000080000000000000000101fffffffffffdff00e0
[omron-only: official 2026.09.03 settings write at 0x80; docs/bluetooth-coverage.md] write tx 1801c000801000000000010000001a01020304062b00007b
[omron-only: synthetic full-echo acknowledgment, unconfirmed on hardware] notify rx 1881c000801000000000010000001a01020304062b0000fb

write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect reading user=1 sys=130 dia=78 pulse=67 time=2025-07-09T06:14:38 irregular=1 movement=1
