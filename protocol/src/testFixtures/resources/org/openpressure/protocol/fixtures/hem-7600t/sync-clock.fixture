# HEM-7600T: explicit Sync clock after a saved-key reconnect. OpenPressure reads the 38-byte settings image at
# 0x260 (byte pairs swapped), finds setting block 3 (image bytes 20..29 at 0x274) valid (all zeros, as in the
# connect fixture; this model refuses an erased block 3) and writes only that block at 0x29a with the fixture
# time + 1 s and its checksum, byte pairs swapped, then ends the session.
# Omron has no standalone clock sync (unsupported). The replays enable the developer override for this untested write.
name hem-7600t/sync-clock
flow sync-clock
advertise name=BLEsmart_0000001F0011223344 services=ecbe3980-c9a2-11e1-b1bd-0002a5d5c51b
dis model=HEM-7600T firmware=0001 software=0001 systemid=0011223344556677
time 2026-01-02T03:04:05 zone=UTC
key 05050505050505050505050505050505

alias unlock b305b680-aee7-11e1-a730-0002a5d5c51b
alias tx db5b55e0-aee7-11e1-965e-0002a5d5c51b,e0b8a060-aee7-11e1-92f4-0002a5d5c51b,0ae12b00-aee8-11e1-a192-0002a5d5c51b,10e1ba60-aee8-11e1-89e5-0002a5d5c51b
alias rx 49123040-aee8-11e1-a74d-0002a5d5c51b,4d0bf320-aee8-11e1-a0d9-0002a5d5c51b,5128ce60-aee8-11e1-b84b-0002a5d5c51b,560f1420-aee8-11e1-8184-0002a5d5c51b

memory fill=ff
# Setting-info block 3 (0x274..0x27d) is checksummed; all zeros is valid.
memory 0x274 00000000000000000000

write unlock 01 05050505050505050505050505050505
notify unlock 8100

write tx 08 00 00 00 00 10 00 18
# Synthetic product identity; byte 14 is the 8-bit sum of bytes 0-13 (5b), which OpenPressure checks for this model.
notify rx 18 80 00 00 00 10 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 5b 0f 00 dd

[ours-only: Sync clock reads the 38-byte settings image at 0x260 before the write; Omron has no standalone clock sync] reads 0x260 38 chunk=56

# Logical block: 00 00, clock 1a 01 02 03 04 06 (fixture time + 1 s), checksum 2a over the 8 bytes before it, 00 kept;
# written with pairs swapped.
[ours-only: OpenPressure-only clock-block write (explicit Sync clock); Omron has no standalone clock sync and writes the clock only after a transfer] write tx 1201c0029a0a 0000011a03020604002a 0073
[ours-only: synthetic full echo acknowledgment; a physical HEM-7600T reply to this write is unconfirmed] notify rx 1281c0029a0a 0000011a03020604002a 00f3

# The session always ends with the normal END, whatever the clock outcome.
write tx 08 0f 00 00 00 00 00 07
notify rx 08 8f 00 00 00 00 00 87

expect clock acknowledged
